# Windows integration test — copy to .env and fill in WIN_IP, WIN_USER, WIN_PASS.
# This file is committed. .env is gitignored.
#
# Run:
#   go test -v -tags integration -run TestWindowsConnectivity ./...

WIN_VM_NAME=win10
WIN_SNAPSHOT_NAME=windows-update

# IP de la VM KVM (ej: 192.168.122.100)
WIN_IP=
# usuario Windows
WIN_USER=
# contraseña Windows (opcional si usas SSH key)
WIN_PASS=
